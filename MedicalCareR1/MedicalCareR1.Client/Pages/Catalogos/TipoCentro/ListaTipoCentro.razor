@using MedicalCareR1.Shared.DTOs.TipoCentroMedicos
@* // *@
<MudContainer Fixed="true">
    @* Ancho fijo *@
    <MudDataGrid T="TipoCentroResponseDto"
                 Dense="true"
                 @ref="grid"
                 Hover="true"
                 Elevation="2"
                 RowsPerPage="5"
                 Height="400px"
                 ServerData="LoadServerData">
        @* Loading para espera *@
        <LoadingContent>
            <div class="d-flex flex-column align-center justify-center" style="height:200px;">
                <MudProgressCircular Indeterminate="true" />
                <MudText Class="mt-2">Cargando Tipos de Centro...</MudText>
            </div>
        </LoadingContent>
        @* Cabcera de la Lista *@
        <ToolBarContent>
            @* Titulo *@
            <MudText Typo="Typo.h6">Listado de Tipos de Centro</MudText>
            <MudSpacer />
            @* Campo de Busqueda *@
            <MudTextField T="string"
                          Placeholder="Busqueda"
                          ValueChanged="OnSearchChanged"
                          Adornment="Adornment.Start"
                          Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Class="mt-0"></MudTextField>
            <MudSpacer />
            @* Boton Nuevo *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Style="font-size: 12px;"
                       OnClick="NuevoTipo">
                Nuevo
            </MudButton>
        </ToolBarContent>
        @* Definicion de las columnas *@
        <Columns>

            <PropertyColumn Property="x => x.Id" HeaderStyle="@_HeaderStyle" Title="Id" CellStyle="width:120px" />
            <PropertyColumn Property="x => x.name" HeaderStyle="@_HeaderStyle" Title="Descripción" />
            <TemplateColumn Title="Acciones" HeaderStyle="@_HeaderStyle" Context="context" CellStyle="width:150px">
                <CellTemplate>
                    <div class="d-flex">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       OnClick="@(() => EditarTipo(context.Item))" />
                        <MudSwitch T="bool"
                                   Value="context.Item.isActive"
                                   Color="Color.Success"
                                   UncheckedColor="Color.Error"
                                   ValueChanged="@(async v =>
                                                    {
                                                        await Desactivar(context.Item);
                                                    })">
                            <MudText Typo="Typo.subtitle2" Class="ml-2">
                                @(context.Item.isActive ? "Activo" : "Inactivo")
                            </MudText>
                        </MudSwitch>
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        @* Paginador *@
        <PagerContent>
            <MudDataGridPager T="TipoCentroResponseDto"
                              ShowPageSizeSelector="true"
                              PageSizeOptions="new int[] {5,10,20,50}" />
        </PagerContent>
    </MudDataGrid>
</MudContainer>
@* // *@

@code {
    private int _total;
    private int _activos;
    private int _inactivos;
    private int _masVisitado;
    private string? _searchString;
    private int? _lastPage;
    private int? _lastPageSize;
    private string? _lastSearch;
    private string? _lastColSort;
    private bool? _lastOrderSort;
    private string _HeaderStyle = "background-color: var(--mud-palette-primary) !important; color: white !important; font-weight: bold; height: 40px;";

    private MudDataGrid<TipoCentroResponseDto>? grid;
    private List<TipoCentroResponseDto> TipoCentros = new();
    private CancellationTokenSource? _cts;


    private async void NuevoTipo()
    {
        TipoCentroResponseDto tipo = new();
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton = true,
            FullWidth = true,
            Position = DialogPosition.CenterRight
        };

        var parameter = new DialogParameters
        {
            {"modelo" , tipo}
        };
        //Console.WriteLine($"Nueva Especialidad - {centro.name}");
        var dialog = await DialogService.ShowAsync<DataEntryTipoCentro>("Registrar Tipo Centro", parameter, options);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            // refresca tu lista de centros
            await CargarDatos();

        }

    }
    //
    private async void EditarTipo(TipoCentroResponseDto tipo)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton = true,
            FullWidth = true,
            Position = DialogPosition.CenterRight
        };

        var parameter = new DialogParameters
        {
            //clonamos para no modificar el original hasta que se guarde
            { "Modelo", new TipoCentroResponseDto
                {
                    Id = tipo.Id,
                    name = tipo.name,
                    isActive = tipo.isActive
                }
            }
        };

        var dialog = await DialogService.ShowAsync<DataEntryTipoCentro>("Editar Tipo Centro", parameter, options);
        // Aquí podrías navegar a una página de edición:
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await CargarDatos();
        }
        // NavigationManager.NavigateTo($"/medical-centers/edit/{centro.Id}");
    }
    //
    private async Task<GridData<TipoCentroResponseDto>>
        LoadServerData(GridState<TipoCentroResponseDto> state, CancellationToken ct)
    {
        //await Task.Delay(1000);//
        //Console.WriteLine("Misma consulta, evitando llamada API");

        var sort = state.SortDefinitions.FirstOrDefault();

        if (_lastPage == state.Page &&
            _lastPageSize == state.PageSize &&
            _lastSearch == _searchString &&
            _lastColSort == sort?.SortBy &&
            _lastOrderSort == sort?.Descending
        )
        {
            return new GridData<TipoCentroResponseDto>(); // evita duplicado
        }
        _lastPage = state.Page;
        _lastPageSize = state.PageSize;
        _lastSearch = _searchString;
        _lastColSort = sort?.SortBy;
        _lastOrderSort = sort?.Descending;
        // ⚠️ Mud usa Page 0-based → tu API usa 1-based
        var page = state.Page + 1;
        var paramters = new ListedPagedDto
            (
             Page: page,
             PageSize: state.PageSize,
             Search: _searchString,
             SortBy: sort?.SortBy,
             SortDesc: sort?.Descending ?? false
            );

        var response = await TipoCentroServicio.GetTipoCentroPaged(paramters);
        if (!response.Success)
        {
            Snackbar.Add(response.ErrorMessage!, Severity.Error);
            return new GridData<TipoCentroResponseDto>
            {
                Items = [],
                TotalItems = 0
            };
        }

        return new GridData<TipoCentroResponseDto>// mapea tu respuesta al formato que espera MudDataGrid
        {
            Items = response.Items,
            TotalItems = response.TotalCount
        };
        
    }
    //
    private async Task CargarDatos()
    {
        await InvokeAsync(async () =>
        {
            if (grid is not null)
            {
                _lastPage = null; //asegurar que se recarga para que pase la validacion inicial
                grid.NavigateTo(0);              // sync
                await grid.ReloadServerData();   // async
                StateHasChanged();
            }
        });
    }

    private async Task OnSearchChanged(string value)
    {
        // Lógica de búsqueda aquí
        if (grid is null)
            return; // 👈 evita crash

        _cts?.Cancel(); // cancela llamada anterior
        _cts = new CancellationTokenSource();

        try
        {
            await Task.Delay(400, _cts.Token); // ⏱ espera (ajustable)
            //Console.WriteLine($"Search changed: {value}");
            _searchString = value;
            grid.NavigateTo(0); // 👈 vuelve a página 1
            await grid.ReloadServerData(); // 🔥 dispara el filtro en backend = LoadServerData
        }
        catch (TaskCanceledException)
        {
            // normal: usuario sigue escribiendo
        }
    }
    //
    private async Task Desactivar(TipoCentroResponseDto tipo)
    {
        // nuevoValor es el valor que el usuario QUIERE poner
        // el valor actual en el objeto es item.isActive (el original antes del click)
        //var valorOriginalEnObjeto = centro.isActive;

        //Configurar el cuadro de diálogo
        var options = new DialogOptions { CloseOnEscapeKey = true, Position = DialogPosition.TopCenter, CloseButton = true };
        bool? result = await DialogService.ShowMessageBoxAsync(
            @tipo.isActive ? "Confirmar Desactivacion" : "Confirmar Activacion",
            $"¿Estás seguro de que deseas {(tipo.isActive ? "Desactivar" : "Activar")} el Tipo de Centro: {tipo.name}?",
            yesText: @tipo.isActive ? "Desactivar" : "Activar",
            cancelText: "Cancelar",
            options: options
        );

        if (result == true)
        {
            // Llamar a la API para eliminar el centro
            var response = await TipoCentroServicio.ToggleTipoCentroAsync(tipo.Id);
            if (!response.Success)
            {
                // restaurar el dato...
                //centro.isActive = valorOriginalEnObjeto;
                Snackbar.Add(response.ErrorMessage!, Severity.Error);

            }
            else
            {
                // API exitosa — confirmar el nuevo valor
                //centro.isActive = nuevoValor;
                Snackbar.Add($"Tipo de Centro {tipo.name} actualizado.", Severity.Success);
            }
            // refresca tu lista de centros
        }
        await CargarDatos();
        // Fuerza re-render para que el Switch refleje el valor correcto
        //await InvokeAsync(StateHasChanged); // Refresca la grilla
    }

}
